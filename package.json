{
  "name": "interview-system-monorepo",
  "private": true,
  "packageManager": "pnpm@9.14.2",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "db:generate": "pnpm --filter @interview/api exec prisma generate",
    "db:push": "pnpm --filter @interview/api exec prisma db push",
    "db:migrate": "pnpm --filter @interview/api exec prisma migrate dev",
    "tunnel": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/ngrok.ps1 http 5173"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  },
  "engines": {
    "node": ">=22"
  }
}
