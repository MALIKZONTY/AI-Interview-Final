# Copy these templates to real `.env` files (already generated in-repo for local dev).
# `.env` is gitignored — commit only this example file.

# -----------------------------------------------------------------------------
# apps/api/.env     — Fastify + Prisma + Cloudinary + AI_SERVICE_URL
# -----------------------------------------------------------------------------
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/interview?schema=public"
# JWT_SECRET="your-secret"
# PORT=4000
# NODE_ENV=development
# FRONTEND_URL=http://localhost:5173
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# AI_SERVICE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# apps/web/.env     — Vite (only VITE_* exposed to the browser)
# -----------------------------------------------------------------------------
# VITE_API_URL=/api

# -----------------------------------------------------------------------------
# apps/api/.env  — object storage for resumes and answer recordings
# Optional: without these, files are written to apps/api/storage/ on local disk.
# Create a PRIVATE bucket named exactly "interview"; nothing is served publicly.
# -----------------------------------------------------------------------------
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service_role secret, server-side only>

# -----------------------------------------------------------------------------
# services/ai-service/.env  — CORS + local faster-whisper (see docs/ML-MODELS-AND-DATA.md)
# -----------------------------------------------------------------------------
# CORS_ORIGINS=http://localhost:4000,http://localhost:5173,http://localhost:8080
# WHISPER_MODEL_SIZE=base   # tiny|base|small|… — CPU: try tiny + int8 for speed
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# OPENAI_API_KEY=          # Groq API key (question generation, follow-ups, scoring)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=openai/gpt-oss-20b   # must be a model your Groq key can access

# -----------------------------------------------------------------------------
# .env (repo root)  — Docker Compose substitution (${CLOUDINARY_*})
# -----------------------------------------------------------------------------
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
